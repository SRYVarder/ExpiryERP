# ==================== Django Settings ====================
DEBUG=True
SECRET_KEY=replace-with-long-random-string
DJANGO_ENV=development

# ==================== Database ====================
DATABASE_URL=postgres://Admin:admin2233@localhost:5432/expiry_erp

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# ==================== Security ====================
ALLOWED_HOSTS = ['.loca.lt', 'curvy-moose-chew.loca.lt', 'localhost', '127.0.0.1']
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://192.168.1.123:8000


# ==================== Email (Optional) ====================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=SupaRetail <no-reply@yourdomain.com>

# ==================== Celery ====================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1